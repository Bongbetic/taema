#!/bin/sh
# taemad-user [USER]: run one user's taema daemon. The taema service creates
# /run/taema/sv/USER/run as a symlink to this file (/run is mounted noexec), so USER
# defaults to the name of the service directory. Places itself in the user's manager/
# leaf (the move out of the root cgroup needs root), then drops to the user.
exec 2>&1
set -eu
PATH=/usr/bin:/usr/sbin:/bin:/sbin
umask 077

user=${1:-$(basename "$(pwd -P)")}
if ! ent=$(getent passwd "$user"); then
    echo "taemad-user: no such user: $user" >&2
    sleep 30
    exit 1
fi
uid=$(printf '%s' "$ent" | cut -d: -f3)
gid=$(printf '%s' "$ent" | cut -d: -f4)
home=$(printf '%s' "$ent" | cut -d: -f6)
cg=/sys/fs/cgroup/user/$uid

if [ ! -d "$cg" ] || [ "$(stat -c %u "$cg")" != "$uid" ]; then
    echo "taemad-user: $cg is not delegated to $user; retrying" >&2
    sleep 5
    exit 1
fi

# Prime root-owned bytecode so the daemon avoids compiling its imported modules after setpriv.
# It must stay readable to the target user, then restore the service's private umask.
unset PYTHONDONTWRITEBYTECODE PYTHONPYCACHEPREFIX PYTHONHOME PYTHONPATH PYTHONOPTIMIZE
umask 022
if ! /usr/bin/python3 -P -m compileall -q /usr/lib/taema/taema; then
    echo "taemad-user: bytecode precompile failed; continuing with source imports" >&2
fi
find /usr/lib/taema/taema -type d -name __pycache__ -prune \
    -exec chmod 755 {} + 2>/dev/null ||
    echo "taemad-user: could not make bytecode cache directories readable" >&2
find /usr/lib/taema/taema -type f -name '*.pyc' \
    -exec chmod 644 {} + 2>/dev/null ||
    echo "taemad-user: could not make bytecode files readable" >&2
umask 077

mkdir -p "$cg/manager"
chown "$uid:$gid" "$cg/manager" "$cg/manager/cgroup.procs"
printf '%s\n' "$$" > "$cg/manager/cgroup.procs"
# Prime the agent leaf the same way: a fresh cgroup.procs is root-owned, so
# without this neither the agent's direct join nor the daemon's direct attach
# could write there.
mkdir -p "$cg/agent"
chown "$uid:$gid" "$cg/agent" "$cg/agent/cgroup.procs"

exec setpriv --reuid="$uid" --regid="$gid" --init-groups --inh-caps=-all --reset-env \
    env HOME="$home" USER="$user" LOGNAME="$user" XDG_RUNTIME_DIR="/run/user/$uid" \
    TAEMA_HOLD="${TAEMA_HOLD:-0}" \
    TAEMA_EVENTD="${TAEMA_EVENTD:-0}" \
    XDG_CONFIG_HOME="$home/.config" XDG_STATE_HOME="$home/.local/state" \
    PATH=/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin \
    /usr/bin/taemad
