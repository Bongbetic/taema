{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://taema.dev/schema/cli/read-v1.json",
 "title": "tæma CLI read output v1",
 "oneOf": [
  {
   "$ref": "#/$defs/view"
  },
  {
   "$ref": "#/$defs/status-record"
  },
  {
   "$ref": "#/$defs/scope"
  },
  {
   "$ref": "#/$defs/reviews"
  },
  {
   "$ref": "#/$defs/events"
  },
  {
   "$ref": "#/$defs/event"
  },
  {
   "$ref": "#/$defs/review"
  },
  {
   "$ref": "#/$defs/explain"
  },
  {
   "$ref": "#/$defs/gc"
  },
  {
   "$ref": "#/$defs/learn"
  },
  {
   "$ref": "#/$defs/doctor"
  },
  {
   "$ref": "#/$defs/memory-view"
  },
  {
   "$ref": "#/$defs/memory-host-record"
  },
  {
   "$ref": "#/$defs/memory-scope-record"
  },
  {
   "$ref": "#/$defs/memory-watch"
  },
  {
   "$ref": "#/$defs/memory-reclaim"
  },
  {
   "$ref": "#/$defs/memory-budget"
  },
  {
   "$ref": "#/$defs/bar"
  },
  {
   "$ref": "#/$defs/history"
  },
  {
   "$ref": "#/$defs/report"
  },
  {
   "$ref": "#/$defs/recent"
  },
  {
   "$ref": "#/$defs/backup"
  },
  {
   "$ref": "#/$defs/top"
  },
  {
   "$ref": "#/$defs/tree"
  }
 ],
 "$defs": {
  "view": {
   "type": "object",
   "required": [
    "schema",
    "kind",
    "status",
    "scopes",
    "scope_count"
   ],
   "properties": {
    "schema": {
     "const": "taema.view.v1"
    },
    "kind": {
     "enum": [
      "status",
      "ls",
      "dash"
     ]
    },
    "status": {
     "anyOf": [
      {
       "$ref": "#/$defs/status-data"
      },
      {
       "type": "null"
      }
     ]
    },
    "scopes": {
     "type": "array",
     "items": {
      "$ref": "#/$defs/scope-data"
     }
    },
    "scope_count": {
     "type": "integer",
     "minimum": 0
    },
    "memory": {
     "$ref": "#/$defs/memory-view"
    },
    "learned": {
     "type": "object",
     "required": [
      "apps",
      "pairs",
      "signatures"
     ],
     "properties": {
      "apps": {
       "type": "array"
      },
      "pairs": {
       "type": "array"
      },
      "signatures": {
       "type": "array"
      }
     },
     "additionalProperties": false
    },
    "budget": {
     "anyOf": [
      {
       "$ref": "#/$defs/memory-budget"
      },
      {
       "type": "null"
      }
     ]
    },
    "events": {
     "type": "array",
     "items": {
      "$ref": "#/$defs/dash-event"
     }
    },
    "reviews": {
     "type": "array"
    },
    "daemon": {
     "enum": [
      "ok",
      "unavailable"
     ]
    }
   },
   "additionalProperties": false
  },
  "status-record": {
   "type": "object",
   "required": [
    "schema",
    "status"
   ],
   "properties": {
    "schema": {
     "const": "taema.status.v1"
    },
    "status": {
     "$ref": "#/$defs/status-data"
    }
   },
   "additionalProperties": false
  },
  "scope": {
   "type": "object",
   "required": [
    "schema",
    "depth",
    "name",
    "processes",
    "memory_bytes",
    "psi_avg10",
    "commands",
    "deprioritized"
   ],
   "properties": {
    "schema": {
     "const": "taema.scope.v1"
    },
    "depth": {
     "type": "integer",
     "minimum": 0
    },
    "name": {
     "type": "string",
     "minLength": 1
    },
    "processes": {
     "type": "integer",
     "minimum": 0
    },
    "memory_bytes": {
     "type": [
      "integer",
      "null"
     ],
     "minimum": 0
    },
    "psi_avg10": {
     "type": [
      "number",
      "null"
     ],
     "minimum": 0
    },
    "commands": {
     "type": "array",
     "items": {
      "type": "string"
     }
    },
    "deprioritized": {
     "type": "boolean"
    },
    "frozen": {
     "type": "boolean"
    },
    "memory": {
     "anyOf": [
      {
       "$ref": "#/$defs/memory-scope"
      },
      {
       "type": "null"
      }
     ]
    },
    "windows": {
     "anyOf": [
      {
       "$ref": "#/$defs/window-summary"
      },
      {
       "type": "null"
      }
     ]
    }
   },
   "additionalProperties": false
  },
  "scope-data": {
   "type": "object",
   "required": [
    "depth",
    "name",
    "processes",
    "memory_bytes",
    "psi_avg10",
    "commands",
    "deprioritized"
   ],
   "properties": {
    "depth": {
     "type": "integer",
     "minimum": 0
    },
    "name": {
     "type": "string",
     "minLength": 1
    },
    "processes": {
     "type": "integer",
     "minimum": 0
    },
    "memory_bytes": {
     "type": [
      "integer",
      "null"
     ],
     "minimum": 0
    },
    "psi_avg10": {
     "type": [
      "number",
      "null"
     ],
     "minimum": 0
    },
    "commands": {
     "type": "array",
     "items": {
      "type": "string"
     }
    },
    "deprioritized": {
     "type": "boolean"
    },
    "frozen": {
     "type": "boolean"
    },
    "memory": {
     "anyOf": [
      {
       "$ref": "#/$defs/memory-scope"
      },
      {
       "type": "null"
      }
     ]
    },
    "windows": {
     "anyOf": [
      {
       "$ref": "#/$defs/window-summary"
      },
      {
       "type": "null"
      }
     ]
    }
   },
   "additionalProperties": false
  },
  "status-data": {
   "type": "object",
   "required": [
    "daemon",
    "mode",
    "feedback_invalid",
    "hold",
    "hold_state",
    "config",
    "details"
   ],
   "properties": {
    "daemon": {
     "enum": [
      "running",
      "unavailable"
     ]
    },
    "mode": {
     "type": "string"
    },
    "authority": {
     "type": "string"
    },
    "authority_source": {
     "type": "string"
    },
    "profile": {
     "type": "string"
    },
    "profile_reason": {
     "type": "string"
    },
    "feedback_invalid": {
     "type": "integer",
     "minimum": 0
    },
    "hold": {
     "type": "string"
    },
    "hold_state": {
     "type": "object",
     "required": [
      "global",
      "scopes",
      "snooze_until",
      "snooze_remaining_s",
      "reason"
     ],
     "properties": {
      "global": {
       "type": "boolean"
      },
      "scopes": {
       "type": "array",
       "items": {
        "type": "string"
       }
      },
      "snooze_until": {
       "type": [
        "number",
        "null"
       ]
      },
      "snooze_remaining_s": {
       "type": "integer",
       "minimum": 0
      },
      "reason": {
       "type": "string"
      }
     },
     "additionalProperties": false
    },
    "guard": {
     "type": "object",
     "required": [
      "active",
      "trigger",
      "triggers",
      "started_at",
      "steps",
      "bytes_freed",
      "last_trigger",
      "last_bytes_freed",
      "last_duration_ms"
     ],
     "properties": {
      "active": {
       "type": "boolean"
      },
      "trigger": {
       "type": [
        "string",
        "null"
       ]
      },
      "triggers": {
       "type": "array",
       "items": {
        "type": "string"
       }
      },
      "started_at": {
       "type": [
        "number",
        "null"
       ]
      },
      "steps": {
       "type": "array",
       "items": {
        "type": "object"
       }
      },
      "bytes_freed": {
       "type": "integer",
       "minimum": 0
      },
      "last_trigger": {
       "type": [
        "string",
        "null"
       ]
      },
      "last_bytes_freed": {
       "type": "integer",
       "minimum": 0
      },
      "last_duration_ms": {
       "type": [
        "number",
        "null"
       ],
       "minimum": 0
      }
     },
     "additionalProperties": false
    },
    "config": {
     "type": "array",
     "items": {
      "type": "string"
     }
    },
    "config_error": {
     "type": [
      "string",
      "null"
     ]
    },
    "details": {
     "anyOf": [
      {
       "type": "object"
      },
      {
       "type": "null"
      }
     ]
    }
   },
   "additionalProperties": false
  },
  "reviews": {
   "type": "object",
   "required": [
    "schema",
    "reviews"
   ],
   "properties": {
    "schema": {
     "const": "taema.reviews.v1"
    },
    "reviews": {
     "type": "array",
     "items": {
      "type": "object"
     }
    }
   },
   "additionalProperties": false
  },
  "events": {
   "type": "object",
   "required": [
    "schema",
    "events",
    "latest_seq",
    "has_more"
   ],
   "properties": {
    "schema": {
     "const": "taema.events.v1"
    },
    "events": {
     "type": "array",
     "items": {
      "$ref": "#/$defs/event-data"
     }
    },
    "latest_seq": {
     "type": "integer",
     "minimum": 0
    },
    "has_more": {
     "type": "boolean"
    }
   },
   "additionalProperties": false
  },
  "event": {
   "type": "object",
   "required": [
    "schema",
    "seq",
    "ts",
    "event",
    "decision_id",
    "topics",
    "data"
   ],
   "properties": {
    "schema": {
     "const": "taema.event.v1"
    },
    "seq": {
     "type": "integer",
     "minimum": 1
    },
    "ts": {
     "type": "number",
     "minimum": 0
    },
    "event": {
     "type": "string"
    },
    "decision_id": {
     "type": [
      "integer",
      "null"
     ]
    },
    "topics": {
     "type": "array",
     "items": {
      "enum": [
       "status",
       "scope",
       "review",
       "decision",
       "memory",
       "guard",
       "profile"
      ]
     }
    },
    "data": {
     "type": "object"
    }
   },
   "additionalProperties": false
  },
  "event-data": {
   "type": "object",
   "required": [
    "seq",
    "ts",
    "event",
    "decision_id",
    "topics",
    "data"
   ],
   "properties": {
    "seq": {
     "type": "integer",
     "minimum": 1
    },
    "ts": {
     "type": "number",
     "minimum": 0
    },
    "event": {
     "type": "string"
    },
    "decision_id": {
     "type": [
      "integer",
      "null"
     ]
    },
    "topics": {
     "type": "array",
     "items": {
      "enum": [
       "status",
       "scope",
       "review",
       "decision",
       "memory",
       "guard",
       "profile"
      ]
     }
    },
    "data": {
     "type": "object"
    }
   },
   "additionalProperties": false
  },
  "review": {
   "type": "object",
   "required": [
    "schema",
    "review"
   ],
   "properties": {
    "schema": {
     "const": "taema.review.v1"
    },
    "review": {
     "type": "object"
    }
   },
   "additionalProperties": false
  },
  "explain": {
   "type": "object",
   "required": [
    "schema",
    "target",
    "explanation"
   ],
   "properties": {
    "schema": {
     "const": "taema.explain.v1"
    },
    "target": {
     "type": "string"
    },
    "explanation": {
     "$ref": "#/$defs/explanation-data"
    }
   },
   "additionalProperties": false
  },
  "explanation-data": {
   "type": "object",
   "required": [
    "identity",
    "scope",
    "provenance",
    "current_decision",
    "authority_source",
    "vetoes",
    "hold",
    "protected",
    "mode_outcomes",
    "learning",
    "plan",
    "unknown"
   ],
   "properties": {
    "identity": {
     "anyOf": [
      {
       "$ref": "#/$defs/explanation-identity"
      },
      {
       "type": "null"
      }
     ]
    },
    "scope": {
     "$ref": "#/$defs/explanation-scope"
    },
    "provenance": {
     "type": "object"
    },
    "current_decision": {
     "$ref": "#/$defs/explanation-decision"
    },
    "authority_source": {
     "type": "string"
    },
    "learn_authority": {
     "type": "object",
     "required": [
      "value",
      "source"
     ],
     "properties": {
      "value": {
       "type": "string"
      },
      "source": {
       "type": "string"
      }
     },
     "additionalProperties": false
    },
    "vetoes": {
     "type": "array",
     "items": {
      "type": "object"
     }
    },
    "hold": {
     "$ref": "#/$defs/explanation-hold"
    },
    "protected": {
     "$ref": "#/$defs/explanation-protected"
    },
    "mode_outcomes": {
     "$ref": "#/$defs/explanation-outcomes"
    },
    "learning": {
     "type": "object"
    },
    "plan": {
     "type": "array",
     "items": {
      "type": "object"
     }
    },
    "unknown": {
     "type": "array",
     "items": {
      "$ref": "#/$defs/explanation-unknown"
     }
    }
   },
   "additionalProperties": false
  },
  "explanation-identity": {
   "type": "object",
   "required": [
    "key",
    "display",
    "kind",
    "validated",
    "reason"
   ],
   "properties": {
    "key": {
     "type": "string"
    },
    "display": {
     "type": "string"
    },
    "kind": {
     "type": "string"
    },
    "validated": {
     "type": "boolean"
    },
    "reason": {
     "type": "string"
    },
    "desktop_id": {
     "type": "string"
    }
   },
   "additionalProperties": false
  },
  "explanation-scope": {
   "type": "object",
   "required": [
    "name",
    "live",
    "deprioritized"
   ],
   "properties": {
    "name": {
     "type": "string"
    },
    "live": {
     "type": "boolean"
    },
    "deprioritized": {
     "type": "boolean"
    },
    "frozen": {
     "type": "boolean"
    }
   },
   "additionalProperties": false
  },
  "explanation-decision": {
   "type": "object",
   "required": [
    "action",
    "confidence",
    "reason"
   ],
   "properties": {
    "action": {
     "type": "string"
    },
    "confidence": {
     "type": [
      "number",
      "null"
     ],
     "minimum": 0,
     "maximum": 1
    },
    "reason": {
     "type": "string"
    }
   },
   "additionalProperties": false
  },
  "explanation-hold": {
   "type": "object",
   "required": [
    "active",
    "reason"
   ],
   "properties": {
    "active": {
     "type": "boolean"
    },
    "reason": {
     "type": "string"
    }
   },
   "additionalProperties": false
  },
  "explanation-protected": {
   "type": "object",
   "required": [
    "blocked",
    "reason"
   ],
   "properties": {
    "blocked": {
     "type": "boolean"
    },
    "reason": {
     "type": "string"
    }
   },
   "additionalProperties": false
  },
  "explanation-outcomes": {
   "type": "object",
   "required": [
    "trigger",
    "modes"
   ],
   "properties": {
    "trigger": {
     "type": "string"
    },
    "modes": {
     "type": "array",
     "items": {
      "$ref": "#/$defs/explanation-mode"
     }
    }
   },
   "additionalProperties": false
  },
  "explanation-mode": {
   "type": "object",
   "required": [
    "mode",
    "verdict",
    "slot",
    "authority",
    "reason"
   ],
   "properties": {
    "mode": {
     "enum": [
      "observe",
      "adopt",
      "enforce",
      "auto"
     ]
    },
    "verdict": {
     "enum": [
      "act",
      "would",
      "keep"
     ]
    },
    "slot": {
     "type": "string"
    },
    "authority": {
     "type": "string"
    },
    "reason": {
     "type": "string"
    }
   },
   "additionalProperties": false
  },
  "explanation-unknown": {
   "type": "object",
   "required": [
    "fact",
    "reason"
   ],
   "properties": {
    "fact": {
     "type": "string"
    },
    "reason": {
     "type": "string"
    }
   },
   "additionalProperties": false
  },
  "gc": {
   "type": "object",
   "required": [
    "schema",
    "result"
   ],
   "properties": {
    "schema": {
     "const": "taema.gc.v1"
    },
    "result": {
     "type": "object"
    }
   },
   "additionalProperties": false
  },
  "learn": {
   "oneOf": [
    {
     "$ref": "#/$defs/learn-show"
    },
    {
     "$ref": "#/$defs/learn-legacy"
    },
    {
     "$ref": "#/$defs/learn-apps"
    },
    {
     "$ref": "#/$defs/learn-pairs"
    },
    {
     "$ref": "#/$defs/learn-signatures"
    }
   ]
  },
  "learn-show": {
   "type": "object",
   "required": [
    "schema",
    "view",
    "legacy",
    "apps",
    "pairs",
    "signatures",
    "counts"
   ],
   "properties": {
    "schema": {
     "const": "taema.learn.v1"
    },
    "view": {
     "const": "show"
    },
    "legacy": {
     "const": false
    },
    "apps": {
     "type": "array",
     "items": {
      "$ref": "#/$defs/learn-app-record"
     }
    },
    "pairs": {
     "type": "array",
     "items": {
      "$ref": "#/$defs/learn-pair-record"
     }
    },
    "signatures": {
     "type": "array",
     "items": {
      "$ref": "#/$defs/learn-signature-record"
     }
    },
    "counts": {
     "$ref": "#/$defs/learn-counts"
    }
   },
   "additionalProperties": false
  },
  "learn-legacy": {
   "type": "object",
   "required": [
    "schema",
    "view",
    "legacy",
    "records",
    "reviews",
    "count"
   ],
   "properties": {
    "schema": {
     "const": "taema.learn.v1"
    },
    "view": {
     "const": "show"
    },
    "legacy": {
     "const": true
    },
    "records": {
     "type": "array",
     "items": {
      "$ref": "#/$defs/learn-pair-record"
     }
    },
    "reviews": {
     "type": "array",
     "items": {
      "type": "object"
     }
    },
    "count": {
     "type": "integer",
     "minimum": 0
    }
   },
   "additionalProperties": false
  },
  "learn-apps": {
   "type": "object",
   "required": [
    "schema",
    "view",
    "records",
    "count"
   ],
   "properties": {
    "schema": {
     "const": "taema.learn.v1"
    },
    "view": {
     "const": "apps"
    },
    "records": {
     "type": "array",
     "items": {
      "$ref": "#/$defs/learn-app-record"
     }
    },
    "count": {
     "type": "integer",
     "minimum": 0
    }
   },
   "additionalProperties": false
  },
  "learn-pairs": {
   "type": "object",
   "required": [
    "schema",
    "view",
    "records",
    "count"
   ],
   "properties": {
    "schema": {
     "const": "taema.learn.v1"
    },
    "view": {
     "const": "pairs"
    },
    "records": {
     "type": "array",
     "items": {
      "$ref": "#/$defs/learn-pair-record"
     }
    },
    "count": {
     "type": "integer",
     "minimum": 0
    }
   },
   "additionalProperties": false
  },
  "learn-signatures": {
   "type": "object",
   "required": [
    "schema",
    "view",
    "records",
    "count"
   ],
   "properties": {
    "schema": {
     "const": "taema.learn.v1"
    },
    "view": {
     "const": "signatures"
    },
    "records": {
     "type": "array",
     "items": {
      "$ref": "#/$defs/learn-signature-record"
     }
    },
    "count": {
     "type": "integer",
     "minimum": 0
    }
   },
   "additionalProperties": false
  },
  "learn-counts": {
   "type": "object",
   "required": [
    "apps",
    "pairs",
    "signatures"
   ],
   "properties": {
    "apps": {
     "type": "integer",
     "minimum": 0
    },
    "pairs": {
     "type": "integer",
     "minimum": 0
    },
    "signatures": {
     "type": "integer",
     "minimum": 0
    }
   },
