#!/bin/sh
# taema: dependency-aware, self-managing cgroup v2 process scopes.
# Installed copy runs the package from /usr/lib/taema; a checkout runs ../src.
lib=/usr/lib/taema
here=$(dirname "$(readlink -f "$0")")
[ -d "$here/../src/taema" ] && lib=$here/../src
# -S skips site-packages (taema is stdlib-only): saves ~5 ms of startup latency.
PYTHONPATH="$lib" PYTHONDONTWRITEBYTECODE=1 exec /usr/bin/python3 -P -S -m taema "$@"
