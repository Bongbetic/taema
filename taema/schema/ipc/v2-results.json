{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "taema-ipc-v2-command-results",
  "$defs": {
    "decision": {
      "type": "object",
      "required": ["id", "ts", "kind", "scope", "owner", "authority", "mode", "why", "corr", "undoable"],
      "properties": {
        "id": {"type": "integer", "minimum": 1},
        "ts": {"type": "number", "minimum": 0},
        "kind": {"type": "string"},
        "scope": {"type": ["string", "null"]},
        "owner": {"type": ["string", "null"]},
        "authority": {"type": "string"},
        "mode": {"type": "string"},
        "why": {"type": "string"},
        "corr": {"type": "string"},
        "undoable": {"type": "boolean"}
      },
      "additionalProperties": true
    },
    "status": {
      "type": "object", "required": ["mode", "uptime_s", "owners", "pairs", "reviews", "latest_decision", "feedback_invalid", "hold", "hold_state"],
      "properties": {
        "mode": {"type": "string"}, "uptime_s": {"type": "integer", "minimum": 0},
        "owners": {"type": "array", "items": {"type": "object", "required": ["scope", "owner"], "properties": {"scope": {"type": "string"}, "owner": {"type": "integer"}}}},
        "pairs": {"type": "array", "items": {"type": "object"}},
        "reviews": {"type": "integer", "minimum": 0}, "auto": {"type": "object"},
        "latest_decision": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/decision"}]},
        "feedback_invalid": {"type": "integer", "minimum": 0},
        "hold": {"type": "string"},
        "hold_state": {
          "type": "object",
          "required": ["global", "scopes", "snooze_until", "snooze_remaining_s", "reason"],
          "properties": {
            "global": {"type": "boolean"},
            "scopes": {"type": "array", "items": {"type": "string"}},
            "snooze_until": {"type": ["number", "null"]},
            "snooze_remaining_s": {"type": "integer", "minimum": 0},
            "reason": {"type": "string"}
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": true
    },
    "memory_budget": {
      "type": "object",
      "required": ["schema", "enabled", "manage", "budget_bytes", "floor_bytes", "allocatable_bytes", "delegated_max_bytes", "scopes"],
      "properties": {
        "schema": {"const": "taema.memory-budget.v1"},
        "enabled": {"type": "boolean"},
        "manage": {"enum": ["soft", "hard"]},
        "budget_bytes": {"type": ["integer", "null"], "minimum": 0},
        "floor_bytes": {"type": ["integer", "null"], "minimum": 0},
        "allocatable_bytes": {"type": ["integer", "null"], "minimum": 0},
        "delegated_max_bytes": {"type": ["integer", "null"], "minimum": 0},
        "fraction": {"type": "number", "minimum": 0, "maximum": 1},
        "infrastructure_bytes": {"type": "integer", "minimum": 0},
        "reserved_bytes": {"type": "integer", "minimum": 0},
        "background_bytes": {"type": "integer", "minimum": 0},
        "scopes": {"type": "array", "items": {"type": "object"}}
      },
      "additionalProperties": false
    },
    "reload": {
      "oneOf": [
        {
          "type": "object",
          "required": ["reloaded", "sources"],
          "properties": {
            "reloaded": {"const": true},
            "sources": {"type": "array", "items": {"type": "string"}}
          },
          "additionalProperties": true
        },
        {
          "type": "object",
          "required": ["error", "config_error"],
          "properties": {
            "error": {"type": "string"},
            "config_error": {"type": "string"}
          },
          "additionalProperties": true
        }
      ]
    },
    "review": {"type": "object", "required": ["reviews"], "properties": {"reviews": {"type": "array", "items": {"type": "object"}}}, "additionalProperties": true},
    "event": {
      "type": "object", "required": ["seq", "ts", "event", "decision_id", "topics", "data"],
      "properties": {
        "seq": {"type": "integer", "minimum": 1},
        "ts": {"type": "number", "minimum": 0},
        "event": {"type": "string"},
        "decision_id": {"type": ["integer", "null"]},
        "topics": {"type": "array", "items": {"enum": ["status", "scope", "review", "decision", "memory", "guard", "profile"]}},
        "data": {"type": "object"}
      },
      "additionalProperties": false
    },
    "subscribe": {
      "type": "object",
      "properties": {
        "subscribed": {"type": "boolean"},
        "topics": {"type": "array", "items": {"type": "string"}},
        "since_seq": {"type": "integer", "minimum": 0},
        "event": {"$ref": "#/$defs/event"},
        "resync": {"type": "boolean"},
        "latest_seq": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": true
    },
    "register": {"type": "object", "required": ["watching"], "properties": {"watching": {"type": "boolean"}}, "additionalProperties": true},
    "attach": {"type": "object", "required": ["ok", "attached"], "properties": {"ok": {"const": true}, "attached": {"type": "array", "items": {"type": "integer"}}}, "additionalProperties": true},
    "job_done": {"type": "object", "required": ["ok"], "properties": {"ok": {"const": true}, "ignored": {"type": "string"}}, "additionalProperties": true},
    "kill_done": {"type": "object", "required": ["ok"], "properties": {"ok": {"const": true}}, "additionalProperties": true},
    "ask": {"type": "object", "required": ["question"], "properties": {"question": {"type": ["object", "null"]}, "reason": {"type": "string"}}, "additionalProperties": true},
    "answer": {"type": "object", "required": ["ok", "choice", "owner", "leftovers"], "properties": {"ok": {"const": true}, "choice": {"enum": ["stop", "keep", "standalone", "never"]}, "owner": {"type": "string"}, "leftovers": {"type": "array", "items": {"type": "string"}}}, "additionalProperties": true},
    "gc": {"type": "object", "required": ["candidates"], "properties": {"candidates": {"type": "array", "items": {"type": "object"}}, "memory": {"type": "array", "items": {"type": "object"}}}, "additionalProperties": true},
    "reclaim": {"type": "object", "required": ["scope", "status"], "properties": {"scope": {"type": ["string", "null"]}, "status": {"enum": ["would", "reclaimed", "skipped", "failed"]}, "reason": {"type": "string"}, "error": {"type": "string"}, "method": {"enum": ["memory.reclaim", "memory.high"]}, "requested_bytes": {"type": "integer", "minimum": 0}, "reclaimed_bytes": {"type": ["integer", "null"], "minimum": 0}, "current_before": {"type": ["integer", "null"], "minimum": 0}, "current_after": {"type": ["integer", "null"], "minimum": 0}, "reclaimable_before": {"type": ["integer", "null"], "minimum": 0}, "reclaimable_after": {"type": ["integer", "null"], "minimum": 0}, "resource_class": {"type": "string"}, "elapsed_ms": {"type": "number", "minimum": 0}}, "additionalProperties": true},
    "feedback": {"type": "object", "required": ["ok"], "properties": {"ok": {"const": true}}, "additionalProperties": true}
  }
}
