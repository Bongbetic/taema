#!/bin/sh
# taema-attach: the one privileged step. Prefer the Rust helper; exec the
# Python fallback when the Rust binary is absent or non-executable (installs
# without Rust, or an operator forcing the fallback for one release).
# Absolute paths only: this runs under sudo with a scrubbed environment.
set -u
if [ -x /usr/libexec/taema/taema-attach.rs ]; then
    exec /usr/libexec/taema/taema-attach.rs "$@"
fi
exec /usr/bin/python3 -I /usr/libexec/taema/taema-attach.py "$@"
